# CIRUS Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
MODE=mock
SECRET_KEY=changeme-please-use-a-strong-secret-in-production
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=dev-api-key-12345

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./cirus_dev.db

# Production (PostgreSQL) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cirus

DB_ECHO=false

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: mock | featherless | groq | openai | anthropic
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Featherless AI
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Firecrawl (optional) ──────────────────────────────────────────────────────
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# ── Wolfram Alpha (optional) ──────────────────────────────────────────────────
WOLFRAM_ENABLED=false
WOLFRAM_APP_ID=
WOLFRAM_BASE_URL=https://api.wolframalpha.com/v2

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_TIMEOUT_SECONDS=120
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.5

# ── Celery (optional) ─────────────────────────────────────────────────────────
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Temporal Workflow Orchestration ───────────────────────────────────────────
# Set TEMPORAL_ENABLED=true to use Temporal for durable pipeline execution.
# When false (default), FastAPI BackgroundTasks are used instead.
#
# To start the local Temporal dev server:
#   Windows:  .\temporal.exe server start-dev
#   macOS:    temporal server start-dev
#
# Then start the worker in a separate terminal:
#   cd backend && python run_worker.py
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cirus-task-queue

# ── Vector Store — Incident Similarity Search (ChromaDB) ──────────────────────
# Enabled by default. Uses chromadb's built-in ONNX embeddings — no GPU needed.
# Incidents are auto-indexed when processing completes and searched at context
# enrichment time to surface similar past incidents.
VECTOR_STORE_ENABLED=true
VECTOR_STORE_PATH=./chroma_db
VECTOR_STORE_COLLECTION=cirus_incidents
VECTOR_STORE_TOP_K=3

# ── Export ────────────────────────────────────────────────────────────────────
EXPORT_DIR=./exports
