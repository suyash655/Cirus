# CIRUS — Root Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-api-key-12345
# Set to "true" to run the frontend with in-memory mock data only (no backend needed)
NEXT_PUBLIC_USE_MOCKS=false

# ── Backend (mirrors backend/.env.example) ────────────────────────────────────
ENVIRONMENT=development
MODE=mock
# IMPORTANT: Change this to a strong random secret in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_STRONG_SECRET_IN_PRODUCTION
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=dev-api-key-12345

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cirus_dev.db
DB_ECHO=false

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: mock | featherless | groq | openai | anthropic
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Optional Services ─────────────────────────────────────────────────────────
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

WOLFRAM_ENABLED=false
WOLFRAM_APP_ID=
WOLFRAM_BASE_URL=https://api.wolframalpha.com/v2

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_TIMEOUT_SECONDS=120
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.5

# ── Celery (optional) ─────────────────────────────────────────────────────────
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ── Export ────────────────────────────────────────────────────────────────────
EXPORT_DIR=./exports
